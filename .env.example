# Copy to .env and fill in. Docker Compose reads it by itself.
# All settings: docs/configuration.md

# --- required ---
# Both: `openssl rand -hex 32`, a different one for each.
JWT_SECRET=
MEDIA_SECRET=
# The site's public address, no trailing slash. Used for link previews and
# artwork in Subsonic apps; tracks play at any address the site is opened at.
MEDIA_BASE_URL=http://localhost:8080

# --- Docker ---
# Where the web container listens on the host: 127.0.0.1 — this machine only
# (behind your reverse proxy); 0.0.0.0 — your network too, e.g. a phone on
# home Wi-Fi at http://<this machine's IP>:8080.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# The database password inside Docker's network (the database isn't exposed).
# It is set when the database is created: changing it later locks the app out
# of the database; change it inside Postgres first (ALTER USER ... PASSWORD).
POSTGRES_PASSWORD=kaikku
# Image version from ghcr.io: latest or a release tag such as v1.2.0.
KAIKKU_VERSION=latest
# How often the API checks for a new yt-dlp, in hours (0 — on start only).
YTDLP_UPDATE_HOURS=24

# --- optional ---
MEDIA_TTL_SECONDS=600
# Days (1–14) to keep audio nobody plays.
AUDIO_KEEP_DAYS=3
WORKER_CONCURRENCY=3
# A second way to Deezer (another IP doubles its per-IP limit), e.g. WARP as
# a SOCKS5 proxy. A proxy on the host is socks5://host.docker.internal:40000,
# and it has to listen on the Docker bridge (172.17.0.1) or 0.0.0.0, not only
# on 127.0.0.1.
DEEZER_PROXY=
# Last.fm scrobbling: last.fm/api/account/create, callback <site>/lastfm
LASTFM_API_KEY=
LASTFM_API_SECRET=
