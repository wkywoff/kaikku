real_ip_header    X-Forwarded-For;
real_ip_recursive on;
include /etc/nginx/kaikku-real-ip.conf;

log_format kaikku '$remote_addr - [$time_local] "$request_method $uri $server_protocol" '
                  '$status $body_bytes_sent "$http_user_agent"';

limit_req_zone $binary_remote_addr zone=kaikku_login:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=kaikku_og:10m rate=10r/m;

resolver 127.0.0.11 valid=10s ipv6=off;
upstream kaikku_api {
  zone kaikku_api 64k;
  server api:8080 resolve;
}

server {
  listen 80;
  server_name _;
  server_tokens off;
  access_log /var/log/nginx/access.log kaikku;
  root /usr/share/nginx/html;

  add_header X-Content-Type-Options "nosniff"                         always;
  add_header X-Frame-Options        "SAMEORIGIN"                      always;
  add_header Referrer-Policy        "strict-origin-when-cross-origin" always;

  add_header X-Robots-Tag           "noindex"                         always;

  add_header Cross-Origin-Opener-Policy "same-origin" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), bluetooth=(), midi=(), browsing-topics=()" always;

  add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; media-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;

  gzip on;
  gzip_proxied any;
  gzip_vary on;
  gzip_min_length 1024;
  gzip_types application/javascript text/css application/json image/svg+xml application/manifest+json;

  client_max_body_size 1m;

  proxy_http_version 1.1;
  proxy_set_header Host              $host;
  proxy_set_header X-Real-IP         $remote_addr;
  proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;

  location /media/covers/ {
    alias /data/storage/covers/;
    expires 1d;
  }

  location /media/ {
    secure_link $arg_st,$arg_e;
    secure_link_md5 "$secure_link_expires$uri ${MEDIA_SECRET}";
    if ($secure_link = "")  { return 403; }
    if ($secure_link = "0") { return 410; }
    alias /data/storage/;
  }

  location ~ ^/api/(login|register)$ {
    limit_req zone=kaikku_login burst=5 nodelay;
    proxy_pass http://kaikku_api;
  }

  location ~ ^/api/tracks/deezer/[0-9]+/audio$ {
    client_max_body_size 200m;
    proxy_request_buffering off;
    proxy_read_timeout 360s;
    proxy_pass http://kaikku_api;
  }

  location = /api/uploads {
    proxy_pass http://kaikku_api;
  }
  location /api/uploads/ {
    client_max_body_size 200m;
    proxy_request_buffering off;
    proxy_read_timeout 420s;
    proxy_pass http://kaikku_api;
  }

  location /api/ {
    proxy_pass http://kaikku_api;
  }

  location /rest/ {
    proxy_pass http://kaikku_api;
  }

  location ~ ^/(album|artist|playlist)/[^/]+$ {
    limit_req zone=kaikku_og burst=5 nodelay;
    proxy_pass http://kaikku_api;
    proxy_intercept_errors on;
    error_page 404 500 502 503 504 = @spa;
  }
  location @spa {
    try_files /index.html =404;
    expires -1;
  }

  location /assets/ {
    expires 1y;
  }
  location ~ ^/(index\.html|sw\.js)$ {
    expires -1;
  }
  location ~ ^/[^/]+\.[A-Za-z0-9]+$ {
    try_files $uri =404;
  }
  location /.well-known/ {
    try_files $uri =404;
  }

  location / {
    try_files $uri /index.html;
  }
}
